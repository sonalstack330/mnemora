<?xml version="1.0" encoding="utf-8"?>
<!-- This config explicitly allows cleartext (non-HTTPS) traffic to specific
     local development addresses. This is safe for development, but should
     NOT be used in a production app talking to real external servers -
     production backends should always use HTTPS. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- 10.0.2.2 is the special alias the Android emulator uses
             to reach your development machine's localhost -->
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>