<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Mnemora" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color - used for buttons, FAB, active elements -->
        <item name="colorPrimary">@color/mnemora_primary</item>
        <item name="colorPrimaryVariant">@color/mnemora_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary/accent color -->
        <item name="colorSecondary">@color/mnemora_accent</item>
        <item name="colorOnSecondary">@color/mnemora_text_primary</item>

        <!-- Status bar color - matches primary for a cohesive look -->
        <item name="android:statusBarColor">@color/mnemora_primary_dark</item>

        <!-- Overall app background -->
        <item name="android:windowBackground">@color/mnemora_background</item>
    </style>
</resources>